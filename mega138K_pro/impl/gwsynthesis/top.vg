module PLL_INIT_0 (
  clk_d,
  n20_6,
  pll_lock,
  enable_r,
  pll_rst,
  lpfres,
  icpsel
)
;
input clk_d;
input n20_6;
input pll_lock;
input [1:1] enable_r;
output pll_rst;
output [2:0] lpfres;
output [0:0] icpsel;
wire n504_5;
wire n541_3;
wire n987_3;
wire n988_3;
