module Gowin_PLL (
  clk_d,
  n7_6,
  memory_clk,
  cmos_xclk_d,
  DDR_pll_lock,
  n20_6,
  enable_r
)
;
input clk_d;
input n7_6;
output memory_clk;
output cmos_xclk_d;
output DDR_pll_lock;
output n20_6;
output [1:1] enable_r;
wire pll_lock;
wire pll_rst;
wire [2:0] lpfres;
wire [1:0] icpsel;
wire VCC;
wire GND;
  Gowin_PLL_MOD u_pll (
    .clk_d(clk_d),
    .pll_rst(pll_rst),
    .icpsel(icpsel[1:0]),
    .lpfres(lpfres[2:0]),
    .pll_lock(pll_lock),
    .memory_clk(memory_clk),
    .cmos_xclk_d(cmos_xclk_d)
);
  PLL_INIT u_pll_init (
    .clk_d(clk_d),
    .n7_6(n7_6),
    .pll_lock(pll_lock),
    .pll_rst(pll_rst),
    .DDR_pll_lock(DDR_pll_lock),
    .n20_6(n20_6),
    .lpfres(lpfres[2:0]),
    .icpsel(icpsel[1:0]),
    .enable_r(enable_r[1])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* Gowin_PLL */
