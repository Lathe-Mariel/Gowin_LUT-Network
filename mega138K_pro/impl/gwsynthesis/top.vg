module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  cmos_pclk_d,
  cmos_href_d,
  cmd_ready,
  wr_data_end,
  wr_data_rdy,
  rd_data_valid,
  cmd_en,
  DDR_pll_lock,
  cmos_vsync_d,
  state_led_d,
  state_led_d_30,
  state_led_d_31,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input cmos_pclk_d;
input cmos_href_d;
input cmd_ready;
input wr_data_end;
input wr_data_rdy;
input rd_data_valid;
input cmd_en;
input DDR_pll_lock;
input cmos_vsync_d;
input [0:0] state_led_d;
input [2:2] state_led_d_30;
input [1:1] state_led_d_31;
output tdo_pad_o;
wire tms_i_c;
wire tck_i_c;
wire tdi_i_c;
wire tdo_o_c;
wire gao_jtag_tdi;
wire gao_jtag_reset;
wire run_test_idle_er1;
wire run_test_idle_er2;
