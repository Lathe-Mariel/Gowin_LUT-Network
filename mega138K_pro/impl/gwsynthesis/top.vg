  cmos_xclk,
  cmos_db,
  cmos_rst_n,
  cmos_pwdn,
  ddr_addr,
  ddr_bank,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  ddr_ck,
  ddr_ck_n,
