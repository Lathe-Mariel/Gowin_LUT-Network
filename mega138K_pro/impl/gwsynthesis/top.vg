input [0:0] cmd;
input [27:3] addr;
input [1:1] state_led_d;
output cmd_ready;
output wr_data_rdy;
output rd_data_valid;
output dma_clk;
output n7_6;
output ddr_ck;
output ddr_ck_n;
output ddr_reset_n;
