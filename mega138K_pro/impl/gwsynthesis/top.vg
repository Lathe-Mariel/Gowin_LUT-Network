module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  cmos_pclk_d,
  prev3_href,
  cmos_href_d,
  cmd_ready,
  wr_data_end,
  wr_data_rdy,
  rd_data_valid,
  cmd_en,
  cmos_vsync_d,
  state_led_d,
  state_led_d_28,
  tp_4,
  tp_10,
  tp_15,
  tp_counter,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input cmos_pclk_d;
input prev3_href;
input cmos_href_d;
input cmd_ready;
input wr_data_end;
input wr_data_rdy;
input rd_data_valid;
input cmd_en;
input cmos_vsync_d;
input [2:2] state_led_d;
input [1:1] state_led_d_28;
input tp_4;
input tp_10;
input tp_15;
input [9:0] tp_counter;
output tdo_pad_o;
wire tms_i_c;
wire tck_i_c;
wire tdi_i_c;
wire tdo_o_c;
wire gao_jtag_tdi;
wire gao_jtag_reset;
wire run_test_idle_er1;
wire run_test_idle_er2;
wire shift_dr_capture_dr;
wire pause_dr;
wire update_dr;
wire enable_er1;
wire enable_er2;
wire f5;
wire tdo_er1;
wire n24_6;
wire [0:0] control0;
wire [5:2] control0_0;
wire [3:0] module_id_reg;
wire [7:7] control0_1;
wire VCC;
wire GND;
  IBUF tms_ibuf (
    .O(tms_i_c),
    .I(tms_pad_i) 
);
  IBUF tck_ibuf (
    .O(tck_i_c),
    .I(tck_pad_i) 
);
  IBUF tdi_ibuf (
    .O(tdi_i_c),
    .I(tdi_pad_i) 
);
  OBUF tdo_obuf (
    .O(tdo_pad_o),
    .I(tdo_o_c) 
);
//black box: GW_JTAG u_gw_jtag
  GW_JTAG u_gw_jtag (
    .tck_pad_i(tck_i_c),
    .tms_pad_i(tms_i_c),
    .tdi_pad_i(tdi_i_c),
    .tdo_er1_i(tdo_er1),
    .tdo_er2_i(GND),
    .tdo_pad_o(tdo_o_c),
    .tck_o(control0[0]),
    .tdi_o(gao_jtag_tdi),
    .test_logic_reset_o(gao_jtag_reset),
    .run_test_idle_er1_o(run_test_idle_er1),
    .run_test_idle_er2_o(run_test_idle_er2),
    .shift_dr_capture_dr_o(shift_dr_capture_dr),
    .pause_dr_o(pause_dr),
    .update_dr_o(update_dr),
    .enable_er1_o(enable_er1),
    .enable_er2_o(enable_er2) 
);
  gw_con_top u_icon_top (
    .shift_dr_capture_dr(shift_dr_capture_dr),
    .update_dr(update_dr),
    .enable_er1(enable_er1),
    .gao_jtag_tdi(gao_jtag_tdi),
    .gao_jtag_reset(gao_jtag_reset),
    .control0(control0_1[7]),
    .control0_22(control0[0]),
    .f5(f5),
    .tdo_er1(tdo_er1),
    .n24_6(n24_6),
    .control0_2(control0_0[2]),
    .control0_4(control0_0[4]),
    .control0_5(control0_0[5]),
    .module_id_reg(module_id_reg[3:0])
);
  ao_top_0 u_la0_top (
    .n24_6(n24_6),
    .cmos_pclk_d(cmos_pclk_d),
    .f5(f5),
    .prev3_href(prev3_href),
    .cmos_href_d(cmos_href_d),
    .cmd_ready(cmd_ready),
    .wr_data_end(wr_data_end),
    .wr_data_rdy(wr_data_rdy),
    .rd_data_valid(rd_data_valid),
    .cmd_en(cmd_en),
    .cmos_vsync_d(cmos_vsync_d),
    .control0_2(control0_0[2]),
    .control0_4(control0_0[4]),
    .control0_5(control0_0[5]),
    .control0_25(control0[0]),
    .module_id_reg(module_id_reg[3:0]),
    .state_led_d(state_led_d[2]),
    .state_led_d_26(state_led_d_28[1]),
    .tp_4(tp_4),
    .tp_10(tp_10),
    .tp_15(tp_15),
    .tp_counter(tp_counter[9:0]),
    .control0_27(control0_1[7])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* gw_gao */
module top (
  clk,
  rst_n,
  sw0,
  sw1,
  fan,
  cmos_scl,
  cmos_sda,
  cmos_vsync,
  cmos_href,
