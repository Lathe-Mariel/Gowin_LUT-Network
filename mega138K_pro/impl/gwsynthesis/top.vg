    .state_led_d_27(state_led_d_30[2]),
    .state_led_d_28(state_led_d_31[1]),
    .control0_29(control0_1[7])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
