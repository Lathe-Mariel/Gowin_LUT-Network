  cmd_en,
  DDR_pll_lock,
  cmos_vsync_d,
  state_led_d,
  state_led_d_30,
  state_led_d_31,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input cmos_pclk_d;
input cmos_href_d;
input cmd_ready;
input wr_data_end;
