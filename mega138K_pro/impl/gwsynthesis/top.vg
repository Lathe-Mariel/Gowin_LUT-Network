wire GND;
  Gowin_PLL_MOD u_pll (
    .clk_d(clk_d),
    .pll_rst(pll_rst),
    .icpsel(icpsel[1:0]),
    .lpfres(lpfres[2:0]),
    .pll_lock(pll_lock),
    .memory_clk(memory_clk),
    .cmos_xclk_d(cmos_xclk_d)
);
  PLL_INIT u_pll_init (
    .clk_d(clk_d),
    .n7_6(n7_6),
    .pll_lock(pll_lock),
    .pll_rst(pll_rst),
    .DDR_pll_lock(DDR_pll_lock),
    .lpfres(lpfres[2:0]),
    .icpsel(icpsel[1:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* Gowin_PLL */
