module DDR3MI (
  cmd_en,
  wr_data_end,
  clk_d,
  memory_clk,
  rst_n_d,
  DDR_pll_lock,
  wr_data,
  cmd,
  addr,
  cmd_ready,
  wr_data_rdy,
  rd_data_valid,
  dma_clk,
  n7_6,
  n2457_6,
  pll_stop,
  ddr_ck,
  ddr_ck_n,
  ddr_reset_n,
  ddr_cs,
  ddr_ras,
  ddr_cas,
  ddr_we,
  ddr_cke,
  ddr_odt,
  init_calib_complete,
  ddr_dm,
  ddr_addr,
  ddr_bank,
  rd_data,
  ddr_dqs,
  ddr_dqs_n,
  ddr_dq
)
;
input cmd_en;
input wr_data_end;
input clk_d;
input memory_clk;
input rst_n_d;
input DDR_pll_lock;
input [255:0] wr_data;
input [0:0] cmd;
input [27:3] addr;
output cmd_ready;
output wr_data_rdy;
output rd_data_valid;
output dma_clk;
output n7_6;
output n2457_6;
output pll_stop;
output ddr_ck;
output ddr_ck_n;
output ddr_reset_n;
output ddr_cs;
output ddr_ras;
output ddr_cas;
output ddr_we;
output ddr_cke;
output ddr_odt;
output init_calib_complete;
output [3:0] ddr_dm;
output [14:0] ddr_addr;
output [2:0] ddr_bank;
output [255:0] rd_data;
inout [3:0] ddr_dqs;
inout [3:0] ddr_dqs_n;
inout [31:0] ddr_dq;
wire VCC;
wire GND;
  \~GW_DDR3_PHY_MC.DDR3MI  gw3_top (
    .cmd_en(cmd_en),
    .wr_data_end(wr_data_end),
    .clk_d(clk_d),
    .memory_clk(memory_clk),
    .rst_n_d(rst_n_d),
    .DDR_pll_lock(DDR_pll_lock),
    .wr_data(wr_data[255:0]),
    .cmd(cmd[0]),
    .addr(addr[27:3]),
    .cmd_ready(cmd_ready),
    .wr_data_rdy(wr_data_rdy),
    .rd_data_valid(rd_data_valid),
    .dma_clk(dma_clk),
    .n7_6(n7_6),
    .n2457_6(n2457_6),
    .pll_stop(pll_stop),
    .ddr_ck(ddr_ck),
    .ddr_ck_n(ddr_ck_n),
    .ddr_reset_n(ddr_reset_n),
    .ddr_cs(ddr_cs),
    .ddr_ras(ddr_ras),
    .ddr_cas(ddr_cas),
    .ddr_we(ddr_we),
    .ddr_cke(ddr_cke),
    .ddr_odt(ddr_odt),
    .init_calib_complete(init_calib_complete),
    .ddr_dm(ddr_dm[3:0]),
    .ddr_addr(ddr_addr[14:0]),
    .ddr_bank(ddr_bank[2:0]),
    .rd_data(rd_data[255:0]),
    .ddr_dqs(ddr_dqs[3:0]),
    .ddr_dqs_n(ddr_dqs_n[3:0]),
    .ddr_dq(ddr_dq[31:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DDR3MI */
module TMDS_PLL (
  clk_d,
  TMDS_DDR_pll_lock,
  serial_clk,
  video_clk
)
;
input clk_d;
output TMDS_DDR_pll_lock;
output serial_clk;
output video_clk;
wire clkout2;
wire clkout3;
wire clkout4;
wire clkout5;
wire clkout6;
wire clkfbout;
wire VCC;
wire GND;
  PLL PLL_inst (
    .LOCK(TMDS_DDR_pll_lock),
    .CLKOUT0(serial_clk),
    .CLKOUT1(video_clk),
    .CLKOUT2(clkout2),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
    .CLKOUT5(clkout5),
    .CLKOUT6(clkout6),
    .CLKFBOUT(clkfbout),
    .CLKIN(clk_d),
    .CLKFB(GND),
    .RESET(GND),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .MDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .MDSEL_FRAC({GND,GND,GND}),
    .ODSEL0({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL0_FRAC({GND,GND,GND}),
    .ODSEL1({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL2({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL3({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL4({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL5({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL6({GND,GND,GND,GND,GND,GND,GND}),
    .DT0({GND,GND,GND,GND}),
    .DT1({GND,GND,GND,GND}),
    .DT2({GND,GND,GND,GND}),
    .DT3({GND,GND,GND,GND}),
    .ICPSEL({GND,GND,GND,GND,GND,GND}),
    .LPFRES({GND,GND,GND}),
    .LPFCAP({GND,GND}),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .ENCLK0(VCC),
    .ENCLK1(VCC),
    .ENCLK2(VCC),
    .ENCLK3(VCC),
    .ENCLK4(VCC),
    .ENCLK5(VCC),
    .ENCLK6(VCC),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}) 
);
defparam PLL_inst.CLK0_IN_SEL=1'b0;
defparam PLL_inst.CLK0_OUT_SEL=1'b0;
defparam PLL_inst.CLK1_IN_SEL=1'b0;
defparam PLL_inst.CLK1_OUT_SEL=1'b0;
defparam PLL_inst.CLK2_IN_SEL=1'b0;
defparam PLL_inst.CLK2_OUT_SEL=1'b0;
defparam PLL_inst.CLK3_IN_SEL=1'b0;
defparam PLL_inst.CLK3_OUT_SEL=1'b0;
