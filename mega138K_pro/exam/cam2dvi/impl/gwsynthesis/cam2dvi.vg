module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  cmos_pclk_d,
  HA_valid,
  VA_valid,
  fps_valid,
  cmos_vsync_d,
  cmos_href_d,
  cmos_16bit_clk,
  cmos_16bit_wr,
  init_calib_complete,
  HActive,
  VActive,
  fps,
  cmos_db_d,
  cmos_16bit_data,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input cmos_pclk_d;
input HA_valid;
input VA_valid;
input fps_valid;
input cmos_vsync_d;
input cmos_href_d;
input cmos_16bit_clk;
input cmos_16bit_wr;
input init_calib_complete;
input [15:0] HActive;
input [15:0] VActive;
input [7:0] fps;
input [7:0] cmos_db_d;
input [15:0] cmos_16bit_data;
output tdo_pad_o;
wire tms_i_c;
wire tck_i_c;
wire tdi_i_c;
wire tdo_o_c;
wire gao_jtag_tdi;
wire gao_jtag_reset;
wire run_test_idle_er1;
wire run_test_idle_er2;
wire shift_dr_capture_dr;
wire pause_dr;
wire update_dr;
wire enable_er1;
wire enable_er2;
wire f5;
wire tdo_er1;
wire n24_6;
wire [0:0] control0;
wire [5:2] control0_0;
wire [3:0] module_id_reg;
wire [7:7] control0_1;
wire VCC;
wire GND;
  IBUF tms_ibuf (
    .O(tms_i_c),
    .I(tms_pad_i) 
);
  IBUF tck_ibuf (
    .O(tck_i_c),
    .I(tck_pad_i) 
);
  IBUF tdi_ibuf (
    .O(tdi_i_c),
    .I(tdi_pad_i) 
);
  OBUF tdo_obuf (
    .O(tdo_pad_o),
    .I(tdo_o_c) 
);
//black box: GW_JTAG u_gw_jtag
  GW_JTAG u_gw_jtag (
    .tck_pad_i(tck_i_c),
    .tms_pad_i(tms_i_c),
    .tdi_pad_i(tdi_i_c),
    .tdo_er1_i(tdo_er1),
    .tdo_er2_i(GND),
    .tdo_pad_o(tdo_o_c),
    .tck_o(control0[0]),
    .tdi_o(gao_jtag_tdi),
    .test_logic_reset_o(gao_jtag_reset),
    .run_test_idle_er1_o(run_test_idle_er1),
    .run_test_idle_er2_o(run_test_idle_er2),
    .shift_dr_capture_dr_o(shift_dr_capture_dr),
    .pause_dr_o(pause_dr),
    .update_dr_o(update_dr),
    .enable_er1_o(enable_er1),
    .enable_er2_o(enable_er2) 
);
  gw_con_top u_icon_top (
    .shift_dr_capture_dr(shift_dr_capture_dr),
    .update_dr(update_dr),
    .enable_er1(enable_er1),
    .gao_jtag_tdi(gao_jtag_tdi),
    .gao_jtag_reset(gao_jtag_reset),
    .control0(control0_1[7]),
    .control0_15(control0[0]),
    .f5(f5),
    .tdo_er1(tdo_er1),
    .n24_6(n24_6),
    .control0_2(control0_0[2]),
    .control0_4(control0_0[4]),
    .control0_5(control0_0[5]),
    .module_id_reg(module_id_reg[3:0])
);
  ao_top_0 u_la0_top (
    .n24_6(n24_6),
    .cmos_pclk_d(cmos_pclk_d),
    .f5(f5),
    .gao_jtag_reset(gao_jtag_reset),
    .HA_valid(HA_valid),
    .VA_valid(VA_valid),
    .fps_valid(fps_valid),
    .cmos_vsync_d(cmos_vsync_d),
    .cmos_href_d(cmos_href_d),
    .cmos_16bit_clk(cmos_16bit_clk),
    .cmos_16bit_wr(cmos_16bit_wr),
    .init_calib_complete(init_calib_complete),
    .control0_2(control0_0[2]),
    .control0_4(control0_0[4]),
    .control0_5(control0_0[5]),
    .control0_23(control0[0]),
    .module_id_reg(module_id_reg[3:0]),
    .HActive(HActive[15:0]),
    .VActive(VActive[15:0]),
    .fps(fps[7:0]),
    .cmos_db_d(cmos_db_d[7:0]),
    .cmos_16bit_data(cmos_16bit_data[15:0]),
    .control0_24(control0_1[7])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* gw_gao */
module TMDS_PLL (
  clk_d,
  TMDS_DDR_pll_lock,
  serial_clk,
  video_clk
)
;
input clk_d;
output TMDS_DDR_pll_lock;
output serial_clk;
output video_clk;
wire clkout2;
wire clkout3;
wire clkout4;
wire clkout5;
wire clkout6;
wire clkfbout;
wire VCC;
wire GND;
  PLL PLL_inst (
    .LOCK(TMDS_DDR_pll_lock),
    .CLKOUT0(serial_clk),
    .CLKOUT1(video_clk),
    .CLKOUT2(clkout2),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
    .CLKOUT5(clkout5),
    .CLKOUT6(clkout6),
    .CLKFBOUT(clkfbout),
    .CLKIN(clk_d),
    .CLKFB(GND),
    .RESET(GND),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .MDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .MDSEL_FRAC({GND,GND,GND}),
    .ODSEL0({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL0_FRAC({GND,GND,GND}),
    .ODSEL1({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL2({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL3({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL4({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL5({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL6({GND,GND,GND,GND,GND,GND,GND}),
    .DT0({GND,GND,GND,GND}),
    .DT1({GND,GND,GND,GND}),
    .DT2({GND,GND,GND,GND}),
    .DT3({GND,GND,GND,GND}),
    .ICPSEL({GND,GND,GND,GND,GND,GND}),
    .LPFRES({GND,GND,GND}),
    .LPFCAP({GND,GND}),
    .PSSEL({GND,GND,GND}),
    .PSDIR(GND),
    .PSPULSE(GND),
    .ENCLK0(VCC),
    .ENCLK1(VCC),
    .ENCLK2(VCC),
    .ENCLK3(VCC),
    .ENCLK4(VCC),
    .ENCLK5(VCC),
    .ENCLK6(VCC),
    .SSCPOL(GND),
    .SSCON(GND),
    .SSCMDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .SSCMDSEL_FRAC({GND,GND,GND}) 
);
